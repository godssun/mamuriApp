# ===========================================
# Mamuri Production Environment Variables
# ===========================================
# Copy this file to .env.production on the server
# and fill in the actual values.
#
# NEVER commit .env.production to git.
# ===========================================

# ---- PostgreSQL ----
POSTGRES_DB=mamuri
DB_USERNAME=mamuri
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Spring Boot Database URL ----
# This is set automatically in docker-compose.prod.yml
# DATABASE_URL=jdbc:postgresql://postgres:5432/mamuri

# ---- JWT ----
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING

# ---- AI Provider ----
AI_PROVIDER=openai
AI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://mamuri.app

# ---- Feature Flags ----
FEATURE_PREMIUM_ENABLED=false
FEATURE_QUOTA_ENABLED=false
FEATURE_CONVERSATION_ENABLED=true
RATE_LIMIT_ENABLED=true

# ---- Stripe (optional, disabled in v1) ----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DELUXE_MONTHLY=
STRIPE_PRICE_DELUXE_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# ---- Firebase (Social Login) ----
# Docker volume으로 마운트된 Firebase 서비스 계정 JSON 파일 경로
# 소셜 로그인을 사용하지 않으면 비워두세요
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json

# ---- File Upload ----
UPLOAD_DIR=/app/uploads
